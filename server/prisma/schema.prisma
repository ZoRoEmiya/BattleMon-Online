generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  teams    Team[]
  battles1 Battle[] @relation("Player1")
  battles2 Battle[] @relation("Player2")
  battleHistories BattleHistory[]
}

model Creature {
  id   Int    @id @default(autoincrement())
  name String
  type String
  hp   Int
  atk  Int
  def  Int
  spd  Int

  moves         CreatureMove[]
  teamCreatures TeamCreature[] 
}

model Move {
  id       Int     @id @default(autoincrement())
  name     String
  type     String
  power    Int?
  accuracy Int
  effect   String?

  creatures CreatureMove[]
}

model CreatureMove {
  id         Int @id @default(autoincrement())
  creatureId Int
  moveId     Int

  creature Creature @relation(fields: [creatureId], references: [id])
  move     Move     @relation(fields: [moveId], references: [id])
}

model Team {
  id     Int    @id @default(autoincrement())
  name   String
  userId Int

  user      User           @relation(fields: [userId], references: [id])
  creatures TeamCreature[]
}

model TeamCreature {
  id         Int @id @default(autoincrement())
  teamId     Int
  creatureId Int
  slot       Int

  currentHp   Int
  atkModifier Float @default(1)
  defModifier Float @default(1)
  spdModifier Float @default(1)

  team     Team     @relation(fields: [teamId], references: [id])
  creature Creature @relation(fields: [creatureId], references: [id])
}

model Battle {
  id        Int      @id @default(autoincrement())
  player1Id Int
  player2Id Int
  status    String
  winnerId  Int?
  createdAt DateTime @default(now())

  player1 User @relation("Player1", fields: [player1Id], references: [id])
  player2 User @relation("Player2", fields: [player2Id], references: [id])

  turns BattleTurn[]
}

model BattleTurn {
  id         Int    @id @default(autoincrement())
  battleId   Int
  turnNumber Int
  actionData String

  battle Battle @relation(fields: [battleId], references: [id])
}

model BattleHistory {
  id           Int      @id @default(autoincrement())
  userId       Int
  opponentName String
  result       String
  status       String
  logs         String
  createdAt    DateTime @default(now())
  endedAt      DateTime?

  user User @relation(fields: [userId], references: [id])
}
